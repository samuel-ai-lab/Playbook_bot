# Required
GROQ_API_KEY=
NOTION_TOKEN=
NOTION_DB_ID=
G_SHEETS_JSON=
# Alternative for CI-safe formatting: base64-encoded service account JSON
G_SHEETS_JSON_B64=
SHEET_ID=

# Optional
WORKSHEET_NAME=
SHEET_STATUS_COL=Status
SHEET_URL_COL=URL
SHEET_NOTION_URL_COL=Notion URL
SHEET_TITLE_COL=Notion Title
SHEET_ERROR_COL=Error

GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=openai/gpt-oss-120b
TRANSCRIPT_API_KEY=
TRANSCRIPT_API_BASE_URL=https://transcriptapi.com
TRANSCRIPT_API_TIMEOUT_SECONDS=45
TRANSCRIPT_API_MAX_RETRIES=3
TRANSCRIPT_API_RETRY_BASE_SEC=1.5
BRAIN_TRANSCRIPT_CHUNK_CHARS=40000
BRAIN_MAX_CHUNKS=200
BRAIN_MERGE_BATCH_SIZE=8
BRAIN_MIN_CHUNK_CHARS=8000
BRAIN_LONG_VIDEO_SECONDS=3600
BRAIN_LLM_MAX_RETRIES=6
BRAIN_LLM_RETRY_BASE_SEC=1.5
BRAIN_LLM_MAX_BACKOFF_SEC=45
BRAIN_LLM_MIN_INTERVAL_SEC=0.35
GROQ_WHISPER_MODEL=whisper-large-v3
USE_GROQ_WHISPER=true
GROQ_MAX_UPLOAD_BYTES=24000000
GROQ_AUDIO_CHUNK_SECONDS=900
INSTAGRAM_EXTRACTOR_PROVIDER=apify
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR_ID=
APIFY_INSTAGRAM_INPUT_MODE=urls
APIFY_INSTAGRAM_EXTRA_INPUT_JSON=
APIFY_INSTAGRAM_TIMEOUT_SECONDS=300
INSTAGRAM_APIFY_FALLBACK_TO_YTDLP=false
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
YOUTUBE_CAPTION_FALLBACK_ENABLED=false
YOUTUBE_AUDIO_FALLBACK_ENABLED=false
YOUTUBE_FETCH_DURATION=false
YOUTUBE_DOWNLOADER=pytubefix

# Only needed when USE_GROQ_WHISPER=false
LOCAL_WHISPER_MODEL=base
