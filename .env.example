# Required
OPENAI_API_KEY=
NOTION_TOKEN=
NOTION_DB_ID=
G_SHEETS_JSON=
# Alternative for CI-safe formatting: base64-encoded service account JSON
G_SHEETS_JSON_B64=
SHEET_ID=

# Optional
WORKSHEET_NAME=
SHEET_STATUS_COL=Status
SHEET_URL_COL=URL
SHEET_NOTION_URL_COL=Notion URL
SHEET_TITLE_COL=Notion Title
SHEET_ERROR_COL=Error

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5
OPENAI_MAX_OUTPUT_TOKENS=32000
OPENAI_TEXT_VERBOSITY=high
OPENAI_REASONING_EFFORT=

# YouTube transcript source
TRANSCRIPT_API_KEY=
TRANSCRIPT_API_BASE_URL=https://transcriptapi.com
TRANSCRIPT_API_TIMEOUT_SECONDS=45
TRANSCRIPT_API_MAX_RETRIES=3
TRANSCRIPT_API_RETRY_BASE_SEC=1.5

# LLM request retry controls
BRAIN_LLM_MAX_RETRIES=6
BRAIN_LLM_RETRY_BASE_SEC=1.5
BRAIN_LLM_MAX_BACKOFF_SEC=45
BRAIN_LLM_MIN_INTERVAL_SEC=0.35

# Optional Groq Whisper for media transcription (Instagram/YT audio fallback)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3
USE_GROQ_WHISPER=true
GROQ_MAX_UPLOAD_BYTES=24000000
GROQ_AUDIO_CHUNK_SECONDS=900
INSTAGRAM_EXTRACTOR_PROVIDER=apify
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR_ID=apify~instagram-reel-scraper
APIFY_INSTAGRAM_INPUT_MODE=auto
APIFY_INSTAGRAM_INCLUDE_TRANSCRIPT=true
APIFY_INSTAGRAM_EXTRA_INPUT_JSON=
APIFY_INSTAGRAM_TIMEOUT_SECONDS=300
INSTAGRAM_APIFY_FALLBACK_TO_YTDLP=false
INSTAGRAM_TRANSCRIPT_ONLY=false
APIFY_INSTAGRAM_TRANSCRIPT_ONLY=
TIKTOK_EXTRACTOR_PROVIDER=apify
APIFY_TIKTOK_TRANSCRIPT_ACTOR_ID=scrape-creators~best-tiktok-transcripts-scraper
APIFY_TIKTOK_EXTRA_INPUT_JSON=
APIFY_TIKTOK_FALLBACK_ACTOR_ID=clockworks~tiktok-scraper
APIFY_TIKTOK_FALLBACK_EXTRA_INPUT_JSON=
APIFY_TIKTOK_FALLBACK_DOWNLOAD_SUBTITLES_OPTIONS=DOWNLOAD_AND_TRANSCRIBE_VIDEOS_WITHOUT_SUBTITLES
APIFY_TIKTOK_TIMEOUT_SECONDS=300
TIKTOK_TRANSCRIPT_ONLY=false
APIFY_TIKTOK_TRANSCRIPT_ONLY=
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
YOUTUBE_CAPTION_FALLBACK_ENABLED=false
YOUTUBE_AUDIO_FALLBACK_ENABLED=false
YOUTUBE_FETCH_DURATION=false
YOUTUBE_DOWNLOADER=pytubefix

# Only needed when USE_GROQ_WHISPER=false
LOCAL_WHISPER_MODEL=base
